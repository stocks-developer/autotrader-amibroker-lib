/******************************************************************************
*
* AutoTrader Web -- settings for the direct (HTTP) library.
*
* THIS IS THE ONLY FILE YOU EDIT. Put your API key in it, save, and refresh
* your charts.
*
* Get your API key from your account settings:
*   https://webx.stocksdeveloper.in/
*
* Version: 1.0
*
******************************************************************************/

/******************************************************************************
* YOUR API KEY.
*
* Treat it like a password. Anyone holding it can place orders in your
* accounts. Do not share an AFL file that still has your key in it, and do not
* post it on a forum when asking for help.
******************************************************************************/

AT_API_KEY = "<API_KEY>";

/******************************************************************************
* Where the requests go. Leave this alone unless support asks you to change it.
******************************************************************************/

AT_BASE_URL = "https://apix.stocksdeveloper.in";

/******************************************************************************
* How long the library re-uses portfolio data before asking the server again,
* in seconds.
*
* Your strategy may call twenty different get...() functions on every bar. Each
* one is answered from the copy held here, so a bar costs one request per
* dataset instead of twenty.
*
* Lowering these does NOT get you fresher data. The server allows roughly one
* portfolio request per second per account and answers anything faster than
* that from its own copy, so a smaller number here buys extra requests and the
* same numbers. Raise them if you trade slowly and want less traffic.
*
* Holdings barely move during the day, which is why they are refreshed rarely.
******************************************************************************/

AT_TTL_ORDERS = 2;

AT_TTL_POSITIONS = 2;

AT_TTL_MARGINS = 30;

AT_TTL_HOLDINGS = 300;

/******************************************************************************
* Safety limit on how many rows one dataset may hold. A portfolio never comes
* close to this; it exists so a malformed reply can never spin a chart.
******************************************************************************/

AT_HTTP_MAX_ROWS = 2000;

/******************************************************************************
* Seconds before the library assumes a refresh that never finished is dead and
* lets another chart try. Only reached when a chart is stopped mid-request.
******************************************************************************/

AT_HTTP_LOCK_TIMEOUT = 60;

/******************************************************************************
* Print every request and reply to AmiBroker's trace window.
*
* Useful when setting up, noisy afterwards. It does NOT print your API key.
******************************************************************************/

AT_HTTP_DEBUG = False;

/******************************************************************************
* THE API CALL LOG -- how to find out where your requests are going.
*
* Every request this library sends is written to one CSV file per day, shared
* by every chart:
*
*     <AmiBroker>\Logs\autotrader-api-YYYY-MM-DD.csv
*
* Open it in Excel. Each line with SERVED_BY = NETWORK is one request; CACHE
* and BUSY lines cost nothing. The CHART, SYMBOL and MODE columns say which
* pane or Exploration it came from, and TARGET says what was asked for.
*
* This is the file to look at first if you are told you are making too many
* requests. It does NOT contain your API key.
******************************************************************************/

AT_LOG = True;

/******************************************************************************
* Also log the calls that were answered from the cache and never reached the
* server.
*
* Leave this OFF for normal trading. The number of lines is decided by your
* strategy rather than by the library -- an Exploration over 500 symbols
* reading twenty fields a bar writes ten thousand of them -- and each line is a
* file write, so it will slow a scan down.
*
* Turn it ON when you want to see WHICH of your calls are driving the
* requests, and off again once you know.
******************************************************************************/

AT_LOG_CALLS = False;

/******************************************************************************
* Where that file goes. Change it if AmiBroker cannot write to the folder
* above -- if it cannot, the log switches itself off and says so in the trace
* window.
*
* Keep it the SAME for every chart. The file is worth having because it adds
* every chart's traffic up in one place, which a per-chart folder would undo.
*
* Left alone, it is a Logs folder inside your AmiBroker folder.
******************************************************************************/

AT_LOG_DIRECTORY = fgetcwd() + "\\Logs";
